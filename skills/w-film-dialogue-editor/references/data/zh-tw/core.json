    {
      "id": "tw-core-001",
      "phrase": "欸",
      "variants": [],
      "meaning": "叫住人、開場的發語詞，也帶一點撒嬌或提醒",
      "categories": {
        "age": [
          "teen",
          "young"
        ],
        "tone": [
          "blunt",
          "warm"
        ],
        "function": [
          "greet"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "friend",
          "colleague",
          "client"
        ]
      },
      "example": "欸，你等一下有空嗎？",
      "situation": "朋友、同事之間開場，或從後面叫住人",
      "avoid": [
        "對客戶、長輩單獨一個「欸」很沒禮貌，要加稱謂"
      ],
      "note": "全台通用。北部講得短，南部會拉長成「欸～」，帶撒嬌。",
      "tags": [
        "開場",
        "日常"
      ],
      "source": "general"
    },
    {
