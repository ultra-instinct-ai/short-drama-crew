    {
      "id": "cn-core-007",
      "phrase": "对不起",
      "variants": [],
      "meaning": "正式道歉，认错",
      "categories": {
        "age": [
          "teen",
          "young",
          "mid",
          "senior",
          "elder"
        ],
        "archetype": [
          "office",
          "student"
        ],
        "tone": [
          "polite"
        ],
        "function": [
          "apology"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "stranger",
          "colleague",
          "client",
          "family"
        ]
      },
      "example": "对不起，是我弄错了。",
      "situation": "真的伤到人、办错事、当众失礼",
      "note": "分量重；说完通常要跟一句补救（我来改、我赔）。",
      "tags": [
        "客套",
        "日常"
      ],
      "source": "general",
      "avoid": [
        "小事（撞一下、借过）说「对不起」，会把对方吓一跳，用「不好意思」就够"
      ]
    },
