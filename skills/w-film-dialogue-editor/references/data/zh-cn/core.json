  "entries": [
    {
      "id": "cn-core-001",
      "phrase": "您好",
      "variants": [
        "您"
      ],
      "meaning": "客气的「你」，对长辈、客户、陌生人、服务对象的默认称呼",
      "categories": {
        "age": [
          "mid",
          "senior",
          "elder"
        ],
        "archetype": [
          "office",
          "sales",
          "waitress"
        ],
        "tone": [
          "polite"
        ],
        "function": [
          "greet"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "client",
          "stranger"
        ]
      },
      "example": "您好，请问是张先生吗？",
      "situation": "打电话找人、前台接待、第一次见客户",
      "note": "「您」在北方（北京、东北、山东）用得比南方密；南方平辈之间多说「你」。服务业、电话销售几乎把它当标配开场。",
      "tags": [
        "客套",
        "開場",
        "日常"
      ],
      "source": "general",
      "avoid": [
        "朋友、平辈之间说「您好」会显得生分，像在营业"
      ]
    },
    {
      "id": "cn-core-002",
      "phrase": "吃了吗",
      "variants": [
        "吃了没",
        "吃了吗您"
      ],
      "meaning": "熟人碰面的招呼，等于「你好」，不是真问吃饭没有",
      "categories": {
        "age": [
          "senior",
          "elder"
        ],
        "archetype": [
          "housewife",
          "elder"
        ],
        "tone": [
          "warm"
        ],
        "function": [
          "greet"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "friend",
          "family"
        ]
      },
      "example": "哟，吃了吗您呐？",
      "situation": "老邻居在楼道、小区门口碰面",
      "note": "北方（北京、山东、东北）老一辈的招呼；南方少见；00 后基本改用「干嘛呢」。",
      "tags": [
        "開場",
        "日常",
        "老派"
      ],
      "source": "general",
      "avoid": [
        "对客户、对领导说会显得没分寸，太家常了"
      ]
    },
    {
      "id": "cn-core-003",
      "phrase": "干嘛呢",
      "variants": [
        "干啥呢",
        "忙什么呢"
      ],
      "meaning": "打招呼问对方在忙什么；语气一重就变成质问「你想干什么」",
      "categories": {
        "age": [
          "young",
          "mid"
        ],
        "archetype": [
          "office",
          "student"
        ],
        "tone": [
          "warm"
        ],
        "function": [
          "greet",
          "question"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "friend",
          "family"
        ]
      },
      "example": "干嘛呢？半天不回消息。",
      "situation": "微信找朋友、找家人，最常用的开场",
      "note": "比「你好」自然得多；「干啥呢」偏北方，南方人多说「在干嘛」。",
      "tags": [
        "開場",
        "日常"
      ],
      "source": "general",
      "avoid": [
        "不熟的人连发两句，像查岗"
      ]
    },
    {
      "id": "cn-core-004",
      "phrase": "麻烦您了",
      "variants": [],
      "meaning": "托人办事、占了别人时间之后的客气话",
      "categories": {
        "age": [
          "mid",
          "senior"
        ],
        "archetype": [
          "office",
          "sales"
        ],
        "tone": [
          "polite"
        ],
        "function": [
          "thanks"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "colleague",
          "client",
          "stranger"
        ]
      },
      "example": "这事儿麻烦您了，回头请您吃饭。",
      "situation": "请同事帮忙、让物业跑一趟、托人递话",
      "note": "客气程度偏高；对方真办完了还会补一句「真是太麻烦您了」。",
      "tags": [
        "客套",
        "日常"
      ],
      "source": "general",
      "avoid": [
        "平级同事之间天天说，会显得假客气、生分"
      ]
    },
    {
      "id": "cn-core-005",
      "phrase": "辛苦啦",
      "variants": [],
      "meaning": "对下属、同事、服务人员的一句笼统肯定，未必真觉得辛苦",
      "categories": {
        "age": [
          "mid",
          "senior"
        ],
        "archetype": [
          "office",
          "boss"
        ],
        "tone": [
          "polite"
        ],
        "function": [
          "praise",
          "thanks"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "colleague",
          "client"
        ]
      },
      "example": "加班到这么晚，辛苦啦。",
      "situation": "领导对下属、同事之间、点完外卖对骑手",
      "note": "互联网公司最泛滥的客套，一天能说八遍；实际含义接近「知道了，继续干」。",
      "tags": [
        "公司",
        "客套",
        "上班族"
      ],
      "source": "general",
      "avoid": [
        "对上级说「辛苦啦」会显得居高临下，像在点评人家"
      ]
    },
    {
      "id": "cn-core-006",
      "phrase": "不好意思",
      "variants": [],
      "meaning": "插话、打扰、小失误之前的缓冲，比「对不起」轻",
      "categories": {
        "age": [
          "teen",
          "young",
          "mid",
          "senior"
        ],
        "archetype": [
          "office",
          "student",
          "sales"
        ],
        "tone": [
          "polite"
        ],
        "function": [
          "apology"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "stranger",
          "colleague",
          "client",
          "friend"
        ]
      },
      "example": "不好意思，让一下。",
      "situation": "挤地铁、打断别人说话、迟到五分钟",
      "note": "大陆日常里几乎万能；道歉分量轻重，全看语气拖多长。",
      "tags": [
        "客套",
        "日常"
      ],
      "source": "general",
      "avoid": [
        "真做错大事还说「不好意思」，显得没诚意，要换成「对不起」"
      ]
