    {
      "id": "en-core-005",
      "phrase": "Long time no see.",
      "variants": [
        "Long time."
      ],
      "meaning": "好久不見；已經係美式固定講法，唔當中文直譯嘅錯英文。",
      "categories": {
        "age": [],
        "archetype": [],
        "tone": [
          "warm"
        ],
        "function": [
          "greet"
        ],
        "register": "idiom",
        "profanity": 0,
        "socialDistance": [
          "friend"
        ]
      },
      "example": "Long time no see. You still working at the shop?",
      "situation": "街上面撞到舊朋友",
      "avoid": [
        "正式場合用 It's been a while 或者 It's good to see you again"
      ],
      "note": "源自十九世紀嘅洋涇浜英語，今日全美通用，母語者完全唔會覺得怪。",
      "tags": [
        "開場",
        "日常"
      ],
      "source": "general"
    },
    {
