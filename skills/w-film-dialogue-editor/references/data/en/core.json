    {
      "id": "en-core-001",
      "phrase": "How's it going?",
      "variants": [
        "How's it goin'?",
        "How's everything?"
      ],
      "meaning": "最中性嘅美式打招呼，等於「點呀／近排點」；問嘅人多數唔係真想聽你講詳情。",
      "categories": {
        "age": [],
        "archetype": [],
        "tone": [
          "warm"
        ],
        "function": [
          "greet"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "friend",
          "colleague",
          "stranger",
          "client"
        ]
      },
      "example": "How's it going, man? Haven't seen you in a minute.",
      "situation": "同朋友、同事、熟客見面嘅第一句",
      "avoid": [
        "對第一次見嘅客戶或長輩，用 Nice to meet you 或者 How are you? 穩陣啲；加 man 只留給熟朋友"
      ],
      "note": "全美通用。東岸講得快，變成 How's it goin'。答法：Good, you? ／ Not bad. ／ Can't complain。",
      "tags": [
        "開場",
        "日常"
      ],
      "source": "general"
    },
    {
      "id": "en-core-002",
      "phrase": "What's up?",
      "variants": [
        "What's good?",
        "Sup?"
      ],
      "meaning": "打招呼多過真問你喺做咩；語氣好 casual，等於「喂，點呀」。",
      "categories": {
        "age": [],
        "archetype": [],
        "tone": [
          "warm",
          "blunt"
        ],
        "function": [
          "greet"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "friend",
          "colleague"
        ]
      },
      "example": "What's up? You look like you just saw a ghost.",
      "situation": "後生仔之間見面、或者入房同熟人打招呼",
      "avoid": [
        "對上司、客戶講會太隨便；正式場合用 How are you?"
      ],
      "note": "答 Not much. 就夠，唔使真答。黑人同 Latino 圈子講 What's good?，其他族群跟住用要小心唔自然。",
      "tags": [
        "開場",
        "日常",
        "直球"
      ],
      "source": "general"
    },
    {
