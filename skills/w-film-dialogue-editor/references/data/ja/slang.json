        "age": [
          "teen",
          "young"
        ],
        "archetype": [
          "student",
          "designer"
        ],
        "tone": [
          "warm"
        ],
        "function": [
          "praise"
        ],
        "register": "slang",
        "profanity": 0,
        "socialDistance": [
          "friend"
        ]
      },
      "example": "この写真、エモいな。",
      "situation": "朋友聚會睇舊相、聽住一首歌",
      "avoid": [
