    {
      "id": "ja-core-001",
      "phrase": "すみません",
      "variants": [
        "すみませんでした",
        "すいません"
      ],
      "romanization": "sumimasen",
      "meaning": "最萬能嘅一聲：叫人、道歉、道謝、開場都用得，語氣客氣但唔算真心認錯",
      "literal": "不會結束（済む的否定）",
      "categories": {
        "age": [],
        "archetype": [
          "office"
        ],
        "tone": [
          "polite"
        ],
        "function": [
          "apology",
          "greet"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "stranger",
          "colleague",
          "client",
          "friend"
        ]
      },
      "example": "すみません、ちょっといいですか。",
      "situation": "街上想叫住陌生人問路，或者喺店舖叫店員",
      "avoid": [
        "對上司正式認錯要用「申し訳ありません」；只講「すみません」會似敷衍"
      ],
      "note": "東京標準語最常用。語尾升高＝叫人；語尾壓低＝道歉。關西人會講「すんません」。",
      "tags": [
        "客套",
        "日常",
        "敬語"
      ],
      "source": "general"
    },
    {
      "id": "ja-core-002",
      "phrase": "ありがとうございます",
      "variants": [
        "ありがとうございました"
      ],
      "romanization": "arigatou gozaimasu",
      "meaning": "正式嘅多謝，對客人、上司、陌生人；謝嘅係對方嘅好意，唔係單純一個服務",
      "literal": "有難う＝難得有",
      "categories": {
        "age": [],
        "archetype": [
          "office"
        ],
        "tone": [
          "warm",
          "polite"
        ],
        "function": [
          "thanks"
        ],
        "register": "everyday",
        "profanity": 0,
        "socialDistance": [
          "stranger",
          "colleague",
          "client"
        ]
      },
      "example": "ありがとうございます、助かりました。",
      "situation": "收禮、受幫忙、客人道謝",
      "avoid": [
        "對朋友熟人講會太生硬、有距離，用「ありがとう」就夠"
      ],
      "note": "「ありがとうございました」用於已完成嘅事（買完、走人時）；「ありがとうございます」用於仍在發生嘅事。時態錯會好怪。",
      "tags": [
        "客套",
        "敬語",
        "日常"
      ],
      "source": "general"
    },
